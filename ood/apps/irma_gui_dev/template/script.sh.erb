#!/usr/bin/env bash
# IRMA GUI (dev) OOD batch_connect script.
# $port (uvicorn) and $worktree_dir are exported by before.sh.erb.

echo "=== IRMA GUI (dev) Session Starting ==="
echo "uvicorn:${port}"
echo "worktree:${worktree_dir}"

SHARED_ENV=/srv/kapurlab/tools/irma_gui/env
PERSONAL_ENV=/home/${USER}/miniforge3/envs/irma_gui
PERSONAL_BASE_PYTHON=/home/${USER}/miniforge3/bin/python

if [ -d "${SHARED_ENV}" ] && [ -x "${SHARED_ENV}/bin/python" ]; then
  IRMA_ENV="${SHARED_ENV}"
  PYTHON="${SHARED_ENV}/bin/python"
elif [ -d "${PERSONAL_ENV}" ]; then
  IRMA_ENV="${PERSONAL_ENV}"
  PYTHON="${PERSONAL_ENV}/bin/python"
else
  IRMA_ENV=""
  PYTHON="${PERSONAL_BASE_PYTHON}"
fi

# Dev override: prefer the per-session worktree if before.sh.erb set one.
SHARED_IRMA_GUI=/srv/kapurlab/tools/irma_gui
if [ -n "${worktree_dir}" ] && [ -d "${worktree_dir}/backend" ]; then
  IRMA_DIR="${worktree_dir}"
else
  IRMA_DIR="${SHARED_IRMA_GUI}"
fi

export PATH="${IRMA_ENV}/bin:${PATH}"
export PYTHONPATH="${IRMA_DIR}/bin:${PYTHONPATH}"

# Dev: build the frontend from the selected branch's source so UI changes are
# served. Only runs in the per-session worktree (never the shared install).
if [ -n "${worktree_dir}" ] && [ "${IRMA_DIR}" = "${worktree_dir}" ] && [ -d "${IRMA_DIR}/frontend" ]; then
  if [ ! -e "${IRMA_DIR}/frontend/node_modules" ] && [ -d "${SHARED_IRMA_GUI}/frontend/node_modules" ]; then
    ln -s "${SHARED_IRMA_GUI}/frontend/node_modules" "${IRMA_DIR}/frontend/node_modules"
  fi
  echo "Building frontend (vite) from worktree source…"
  ( cd "${IRMA_DIR}/frontend" && npm run build ) \
    || echo "WARN: frontend build failed; serving existing dist/ if present."
fi

cd "${IRMA_DIR}/backend"
echo "Starting uvicorn on port ${port}"
echo "  conda env: ${IRMA_ENV}"
echo "  irma_gui:  ${IRMA_DIR}"
exec $PYTHON -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port "${port}" \
    --log-level info \
    --reload \
    --reload-dir app
